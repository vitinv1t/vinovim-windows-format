<Window x:Class="VinovimFormat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vinovim Windows Format"
        Width="1060" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Fonte}" FontSize="14"
        Background="{StaticResource Fundo}" Foreground="{StaticResource Texto}"
        TextOptions.TextFormattingMode="Display"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" Closing="Window_Closing">

  <Window.Resources>
    <Style x:Key="Titulo" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource FonteTitulo}"/>
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Rotulo" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource TextoMudo}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Paragrafo" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{StaticResource TextoFraco}"/>
      <Setter Property="LineHeight" Value="21"/>
      <Setter Property="Margin" Value="0,0,0,18"/>
    </Style>
    <Style x:Key="Painel" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Superficie}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Linha}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <!-- Uma linha de verificação: ícone + título + detalhe, separadas por linhas finas -->
    <DataTemplate x:Key="ModeloVerificacao">
      <Border BorderBrush="{StaticResource Linha}" BorderThickness="0,0,0,1" Padding="16,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34"/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Path x:Name="Ic" Style="{StaticResource Icone}" Data="{StaticResource IcInfo}" Stroke="#60A5FA" VerticalAlignment="Top" Margin="0,2,0,0" HorizontalAlignment="Left"/>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="13.5"/>
            <TextBlock Text="{Binding Detalhe}" Foreground="{StaticResource TextoFraco}" TextWrapping="Wrap" FontSize="13" Margin="0,2,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Ok">
          <Setter TargetName="Ic" Property="Data" Value="{StaticResource IcCheck}"/>
          <Setter TargetName="Ic" Property="Stroke" Value="{StaticResource Ok}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Aviso">
          <Setter TargetName="Ic" Property="Data" Value="{StaticResource IcAlert}"/>
          <Setter TargetName="Ic" Property="Stroke" Value="{StaticResource Aviso}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Erro">
          <Setter TargetName="Ic" Property="Data" Value="{StaticResource IcX}"/>
          <Setter TargetName="Ic" Property="Stroke" Value="{StaticResource Erro}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="Pilha"><StackPanel/></ItemsPanelTemplate>

    <!-- Uma fase da execução: pendente, em curso (a rodar), feita, erro ou saltada -->
    <DataTemplate x:Key="ModeloFase">
      <Border BorderBrush="{StaticResource Linha}" BorderThickness="0,0,0,1" Padding="16,11">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Ellipse x:Name="Circulo" Stroke="{StaticResource LinhaForte}" StrokeThickness="1.5"/>
            <Path x:Name="Ic" Style="{StaticResource Icone}" Data="{StaticResource IcCheck}" Width="14" Height="14" Visibility="Collapsed"/>
            <Path x:Name="Roda" Style="{StaticResource Icone}" Data="{StaticResource IcSpinner}" Stroke="{StaticResource Destaque}"
                  StrokeThickness="2" Width="18" Height="18" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform><RotateTransform/></Path.RenderTransform>
            </Path>
          </Grid>
          <TextBlock x:Name="Nome" Grid.Column="1" Text="{Binding Nome}" Foreground="{StaticResource TextoMudo}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2" Text="{Binding Detalhe}" Foreground="{StaticResource TextoMudo}" FontSize="12.5" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Estado}" Value="EmCurso">
          <Setter TargetName="Circulo" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="Roda" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Nome" Property="Foreground" Value="{StaticResource Texto}"/>
          <Setter TargetName="Nome" Property="FontWeight" Value="SemiBold"/>
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="Girar">
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Roda" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                 From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="Girar"/>
          </DataTrigger.ExitActions>
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Feito">
          <Setter TargetName="Circulo" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="Ic" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Ic" Property="Stroke" Value="{StaticResource Ok}"/>
          <Setter TargetName="Nome" Property="Foreground" Value="{StaticResource TextoFraco}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Erro">
          <Setter TargetName="Circulo" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="Ic" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Ic" Property="Data" Value="{StaticResource IcX}"/>
          <Setter TargetName="Ic" Property="Stroke" Value="{StaticResource Erro}"/>
          <Setter TargetName="Nome" Property="Foreground" Value="{StaticResource Erro}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Saltada">
          <Setter TargetName="Circulo" Property="StrokeDashArray" Value="2 2"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!-- Barra lateral -->
    <Border DockPanel.Dock="Left" Width="248" Background="{StaticResource Superficie}" BorderBrush="{StaticResource Linha}" BorderThickness="0,0,1,0">
      <DockPanel Margin="22,26,22,22">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,34">
          <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource Destaque}">
            <Path Data="M19 27 H38 L48 51 L58 27 H77 L56 73 H40 Z" Fill="White" Stretch="Uniform" Width="15" Height="15"/>
          </Border>
          <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Vinovim" FontWeight="SemiBold" FontSize="15"/>
            <TextBlock Text="Windows Format" Foreground="{StaticResource TextoMudo}" FontSize="12"/>
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border x:Name="PainelAtualizacao" Background="#1A0078D4" BorderBrush="#550078D4" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,14" Visibility="Collapsed">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Path Style="{StaticResource Icone}" Data="{StaticResource IcDownload}" Stroke="#4CA3EB" Width="14" Height="14" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtAtualizacao" FontSize="12.5" FontWeight="SemiBold" Text="Nova versão disponível"/>
              </StackPanel>
              <Button Content="Descarregar" Style="{StaticResource Primario}" Height="30" FontSize="12.5" Click="BtnAtualizar_Click"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="TxtVersao" Foreground="{StaticResource TextoMudo}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel x:Name="PainelPassos"/>
      </DockPanel>
    </Border>

    <!-- Navegação -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Linha}" BorderThickness="0,1,0,0" Padding="36,14">
      <DockPanel>
        <Button x:Name="BtnSair" Content="Sair" DockPanel.Dock="Left" Click="BtnSair_Click"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BtnVoltar" Content="Voltar" Margin="0,0,8,0" Click="BtnVoltar_Click"/>
          <Button x:Name="BtnAvancar" Content="Continuar" Style="{StaticResource Primario}" Click="BtnAvancar_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer x:Name="Rolagem" VerticalScrollBarVisibility="Auto">
      <Grid Margin="40,34,40,30" MaxWidth="820" HorizontalAlignment="Left">

        <!-- 1. DIAGNÓSTICO -->
        <StackPanel x:Name="PainelDiagnostico">
          <TextBlock Style="{StaticResource Rotulo}" Text="PASSO 1 DE 4"/>
          <TextBlock Style="{StaticResource Titulo}" Text="Diagnóstico do sistema"/>
          <TextBlock Style="{StaticResource Paragrafo}" Text="Antes de alterar o que quer que seja, a aplicação confirma que é seguro avançar. Itens a vermelho têm de ser resolvidos primeiro."/>
          <TextBlock x:Name="TxtResumo" Foreground="{StaticResource TextoFraco}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14" Text="A analisar o computador..."/>
          <Border Style="{StaticResource Painel}">
            <ItemsControl x:Name="ListaDiagnostico" ItemTemplate="{StaticResource ModeloVerificacao}" ItemsPanel="{StaticResource Pilha}"/>
          </Border>
          <Border x:Name="PainelChave" Style="{StaticResource Painel}" Margin="0,14,0,0" Padding="16,12" Visibility="Collapsed">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Copiar" Margin="0,0,8,0" Click="BtnCopiarChave_Click"/>
                <Button Content="Guardar .txt" Click="BtnGuardarChave_Click"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Style="{StaticResource Rotulo}" Text="CHAVE DO WINDOWS"/>
                <TextBlock x:Name="TxtChave" FontFamily="{StaticResource FonteMono}" FontSize="14"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Button x:Name="BtnDiagnostico" HorizontalAlignment="Left" Margin="0,14,0,0" Click="BtnDiagnostico_Click">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource Icone}" Data="{StaticResource IcRefresh}" Width="14" Height="14" Margin="0,0,8,0"/>
              <TextBlock Text="Repetir diagnóstico"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- 2. MODO -->
        <StackPanel x:Name="PainelModo" Visibility="Collapsed">
          <TextBlock Style="{StaticResource Rotulo}" Text="PASSO 2 DE 4"/>
          <TextBlock Style="{StaticResource Titulo}" Text="Modo de formatação"/>
          <TextBlock Style="{StaticResource Paragrafo}" Text="Nenhum dos modos precisa de pen-drive. Se não tiver a certeza, o Modo 1 é o equivalente a formatar com pen-drive."/>

          <Border x:Name="PainelParticaoExistente" Background="#1AFBBF24" BorderBrush="#40FBBF24" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,14" Visibility="Collapsed">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Reiniciar no instalador" Margin="0,0,8,0" Click="BtnRearmar_Click"/>
                <Button Content="Remover partição" Click="BtnLimparParticao_Click"/>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Texto}" Margin="0,0,12,0" VerticalAlignment="Center"
                         Text="Existe uma partição VINOVIM_BOOT de uma utilização anterior."/>
            </DockPanel>
          </Border>

          <RadioButton x:Name="RbModo1" Style="{StaticResource Opcao}" GroupName="Modo" IsChecked="True" Checked="Modo_Changed">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Modo 1 · Formatação limpa com partição temporária"/>
              <TextBlock Foreground="{StaticResource TextoFraco}" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0"
                         Text="Cria a partição oculta VINOVIM_BOOT (cerca de 8 GB), copia o instalador oficial para lá e reinicia diretamente nele. Lá dentro, apaga ou formata o disco do Windows e instala do zero. No fim, a partição é removida e o espaço volta ao C:."/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="RbModo2" Style="{StaticResource Opcao}" GroupName="Modo" Checked="Modo_Changed">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Modo 2 · Reinstalação direta a partir do Windows"/>
              <TextBlock Foreground="{StaticResource TextoFraco}" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0"
                         Text="Monta a ISO e corre o instalador oficial (setup.exe) sem mexer no arranque nem na BIOS. Não depende do &quot;Repor este PC&quot;."/>
            </StackPanel>
          </RadioButton>
          <StackPanel x:Name="PainelTipoModo2" Margin="34,0,0,10" Visibility="Collapsed">
            <RadioButton x:Name="RbLimpa" Style="{StaticResource Opcao}" GroupName="Tipo" IsChecked="True" Checked="Modo_Changed">
              <TextBlock Text="Limpa: apaga programas, definições e ficheiros" FontSize="13"/>
            </RadioButton>
            <RadioButton x:Name="RbManter" Style="{StaticResource Opcao}" GroupName="Tipo" Checked="Modo_Changed">
              <TextBlock Text="Manter ficheiros pessoais: apaga programas e definições" FontSize="13"/>
            </RadioButton>
          </StackPanel>
          <RadioButton x:Name="RbModo3" Style="{StaticResource Opcao}" GroupName="Modo" Checked="Modo_Changed">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Modo 3 · Reparar o &quot;Repor este PC&quot;"/>
              <TextBlock Foreground="{StaticResource TextoFraco}" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0"
                         Text="Não apaga nada. Executa DISM /RestoreHealth, sfc /scannow e reagentc /enable para corrigir o sistema e a recuperação do Windows."/>
            </StackPanel>
          </RadioButton>
        </StackPanel>

        <!-- 3. ISO -->
        <StackPanel x:Name="PainelIso" Visibility="Collapsed">
          <TextBlock Style="{StaticResource Rotulo}" Text="PASSO 3 DE 4"/>
          <TextBlock Style="{StaticResource Titulo}" Text="Imagem oficial do Windows"/>
          <TextBlock x:Name="TxtIntroIso" Style="{StaticResource Paragrafo}"
                     Text="A ISO faz o papel do pen-drive. A app descarrega-a diretamente da Microsoft, ou pode escolher uma que já tenha."/>
          <Border Style="{StaticResource Painel}" Padding="18,16" Margin="0,0,0,22">
            <StackPanel>
              <TextBlock Style="{StaticResource Rotulo}" Text="DESCARREGAR DOS SERVIDORES DA MICROSOFT"/>
              <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="1.4*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CmbVersao" SelectionChanged="CmbVersao_SelectionChanged"/>
                <ComboBox x:Name="CmbIdioma" Grid.Column="2" IsEnabled="False"/>
                <Button x:Name="BtnDescarregarIso" Grid.Column="4" Style="{StaticResource Primario}" IsEnabled="False" Click="BtnDescarregarIso_Click">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icone}" Data="{StaticResource IcDownload}" Stroke="White" Width="14" Height="14" Margin="0,0,8,0"/>
                    <TextBlock Text="Descarregar" Foreground="White"/>
                  </StackPanel>
                </Button>
              </Grid>
              <TextBlock x:Name="TxtDownloadInfo" Foreground="{StaticResource TextoFraco}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"
                         Text="Escolha a versão. O idioma do seu Windows é escolhido automaticamente."/>
              <StackPanel x:Name="PainelProgressoDownload" Margin="0,12,0,0" Visibility="Collapsed">
                <ProgressBar x:Name="BarraDownload" Maximum="100" Margin="0,0,0,10"/>
                <DockPanel>
                  <Button x:Name="BtnCancelarDownload" Content="Cancelar" DockPanel.Dock="Right" Height="30" FontSize="12.5" Click="BtnCancelarDownload_Click"/>
                  <TextBlock x:Name="TxtProgressoDownload" FontFamily="{StaticResource FonteMono}" FontSize="12.5" Foreground="{StaticResource TextoFraco}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
              </StackPanel>
              <TextBlock FontSize="12.5" Foreground="{StaticResource TextoMudo}" TextWrapping="Wrap" Margin="0,12,0,0">
                <Run Text="Se o download direto falhar, use a"/>
                <Hyperlink Foreground="#4CA3EB" TextDecorations="{x:Null}" Click="LnkPaginaOficial_Click"><Run Text="página oficial da Microsoft"/></Hyperlink><Run Text="."/>
              </TextBlock>
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource Rotulo}" Text="OU USE UMA ISO QUE JÁ TEM"/>
          <DockPanel Margin="0,0,0,12">
            <Button x:Name="BtnEscolherIso" Content="Escolher ISO…" Style="{StaticResource Primario}" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BtnEscolherIso_Click"/>
            <TextBox x:Name="TxtCaminhoIso" IsReadOnly="True" VerticalContentAlignment="Center"/>
          </DockPanel>
          <TextBlock x:Name="TxtStatusIso" Foreground="{StaticResource TextoFraco}" Margin="0,0,0,10" TextWrapping="Wrap" Text="Nenhuma ISO selecionada."/>
          <ProgressBar x:Name="ProgressoHash" Maximum="100" Margin="0,0,0,14" Visibility="Collapsed"/>

          <Border x:Name="PainelHash" Style="{StaticResource Painel}" Padding="16,12" Margin="0,0,0,14" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Style="{StaticResource Rotulo}" Text="SHA-256 DA ISO"/>
              <TextBox x:Name="TxtHash" IsReadOnly="True" FontFamily="{StaticResource FonteMono}" FontSize="12" Margin="0,0,0,10"/>
              <TextBlock Style="{StaticResource Rotulo}" Text="COMPARAR COM O HASH PUBLICADO PELA MICROSOFT (OPCIONAL)"/>
              <TextBox x:Name="TxtHashEsperado" FontFamily="{StaticResource FonteMono}" FontSize="12" TextChanged="TxtHashEsperado_TextChanged"/>
              <TextBlock x:Name="TxtHashResultado" Margin="0,8,0,0" FontSize="13"/>
            </StackPanel>
          </Border>

          <Border x:Name="PainelCompat" Style="{StaticResource Painel}" Visibility="Collapsed">
            <ItemsControl x:Name="ListaIso" ItemTemplate="{StaticResource ModeloVerificacao}" ItemsPanel="{StaticResource Pilha}"/>
          </Border>
        </StackPanel>

        <!-- 4. CONFIRMAÇÃO E EXECUÇÃO -->
        <Grid x:Name="PainelConfirmacao" Visibility="Collapsed">
          <StackPanel x:Name="VistaConfirmar">
            <TextBlock Style="{StaticResource Rotulo}" Text="PASSO 4 DE 4"/>
            <TextBlock Style="{StaticResource Titulo}" Text="Confirmação de segurança"/>
            <Border x:Name="AvisoApagar" Background="#14F87171" BorderBrush="#40F87171" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,4,0,16">
              <TextBlock x:Name="TxtAviso" TextWrapping="Wrap" LineHeight="21"/>
            </Border>
            <Border Style="{StaticResource Painel}" Padding="18,6" Margin="0,0,0,22">
              <Grid x:Name="GradeResumo"/>
            </Border>

            <TextBlock Style="{StaticResource Rotulo}" Text="CÓPIA DE SEGURANÇA (RECOMENDADO)"/>
            <DockPanel Margin="0,0,0,8">
              <Button Content="Escolher pasta…" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BtnEscolherPasta_Click"/>
              <TextBox x:Name="TxtPastaBackup" IsReadOnly="True" VerticalContentAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="TxtAvisoPasta" Foreground="{StaticResource Aviso}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
            <WrapPanel Margin="0,0,0,8">
              <Button x:Name="BtnDrivers" Content="Guardar drivers" Margin="0,0,8,8" Click="BtnDrivers_Click"/>
              <Button x:Name="BtnWifi" Content="Guardar redes Wi-Fi" Margin="0,0,8,8" Click="BtnWifi_Click"/>
              <Button x:Name="BtnBitLocker" Content="Guardar chave do BitLocker" Margin="0,0,8,8" Click="BtnBitLocker_Click" Visibility="Collapsed"/>
              <Button Content="Abrir pasta" Margin="0,0,8,8" Click="BtnAbrirPasta_Click"/>
            </WrapPanel>

            <StackPanel Margin="0,8,0,0">
              <CheckBox x:Name="ChkBackup" Margin="0,0,0,10" Checked="Opcao_Changed" Unchecked="Opcao_Changed">
                <TextBlock TextWrapping="Wrap" Text="Já copiei fotos, documentos, ambiente de trabalho e transferências para FORA deste PC."/>
              </CheckBox>
              <CheckBox x:Name="ChkBitLocker" Margin="0,0,0,10" Visibility="Collapsed" Checked="Opcao_Changed" Unchecked="Opcao_Changed">
                <TextBlock TextWrapping="Wrap" Text="Guardei a chave de recuperação do BitLocker fora deste PC."/>
              </CheckBox>
              <CheckBox x:Name="ChkSimular" Margin="0,0,0,16" Checked="Opcao_Changed" Unchecked="Opcao_Changed">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextoFraco}" Text="Modo de teste: mostrar no registo o que seria feito, sem alterar nada."/>
              </CheckBox>
            </StackPanel>

            <StackPanel x:Name="PainelPalavra">
              <TextBlock x:Name="TxtInstrucaoPalavra" Text="Para confirmar, escreva FORMATAR:" Margin="0,0,0,8"/>
              <TextBox x:Name="TxtConfirmacao" Width="240" HorizontalAlignment="Left" FontSize="15" CharacterCasing="Upper" TextChanged="TxtConfirmacao_TextChanged"/>
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="VistaExecutar" Visibility="Collapsed">
            <TextBlock x:Name="TxtRotuloExec" Style="{StaticResource Rotulo}" Text="EXECUÇÃO"/>
            <TextBlock x:Name="TxtTituloExec" Style="{StaticResource Titulo}" Text="A preparar…"/>
            <TextBlock x:Name="TxtStatusExec" Style="{StaticResource Paragrafo}" Text=""/>
            <ProgressBar x:Name="ProgressoExec" Maximum="100" Margin="0,0,0,18"/>

            <Border x:Name="PainelConcluido" CornerRadius="10" BorderThickness="1" Padding="18,16" Margin="0,0,0,16" Visibility="Collapsed"
                    Background="#144ADE80" BorderBrush="#404ADE80">
              <DockPanel>
                <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="18" Background="#264ADE80" Margin="0,0,14,0" VerticalAlignment="Top">
                  <Path x:Name="IcConcluido" Style="{StaticResource Icone}" Data="{StaticResource IcCheck}" Stroke="{StaticResource Ok}" StrokeThickness="2" Width="18" Height="18"/>
                </Border>
                <StackPanel>
                  <TextBlock x:Name="TxtConcluidoTitulo" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                  <TextBlock x:Name="TxtConcluidoTexto" Foreground="{StaticResource TextoFraco}" TextWrapping="Wrap" LineHeight="22"/>
                </StackPanel>
              </DockPanel>
            </Border>

            <Border Style="{StaticResource Painel}" Margin="0,0,0,16">
              <ItemsControl x:Name="ListaFases" ItemTemplate="{StaticResource ModeloFase}" ItemsPanel="{StaticResource Pilha}"/>
            </Border>

            <WrapPanel Margin="0,0,0,12">
              <Button x:Name="BtnReiniciar" Content="Reiniciar agora" Style="{StaticResource Primario}" Margin="0,0,8,8" Visibility="Collapsed" Click="BtnReiniciar_Click"/>
              <Button x:Name="BtnMostrarLog" Content="Mostrar registo detalhado" Margin="0,0,8,8" Click="BtnMostrarLog_Click"/>
              <Button x:Name="BtnAbrirLog" Content="Abrir ficheiro de registo" Margin="0,0,8,8" Click="BtnAbrirLog_Click"/>
            </WrapPanel>
            <TextBox x:Name="TxtLog" Style="{StaticResource Log}" Height="260" Visibility="Collapsed"/>
          </StackPanel>
        </Grid>

      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
