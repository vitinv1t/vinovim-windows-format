<Application x:Class="VinovimFormat.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             DispatcherUnhandledException="App_DispatcherUnhandledException">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Paleta Vinovim -->
      <SolidColorBrush x:Key="Fundo" Color="#09090B"/>
      <SolidColorBrush x:Key="Superficie" Color="#121215"/>
      <SolidColorBrush x:Key="Superficie2" Color="#18181C"/>
      <SolidColorBrush x:Key="Linha" Color="#12FFFFFF"/>
      <SolidColorBrush x:Key="LinhaForte" Color="#2EFFFFFF"/>
      <SolidColorBrush x:Key="Texto" Color="#F5F5F7"/>
      <SolidColorBrush x:Key="TextoFraco" Color="#A1A1AA"/>
      <SolidColorBrush x:Key="TextoMudo" Color="#71717A"/>
      <SolidColorBrush x:Key="Destaque" Color="#0078D4"/>
      <SolidColorBrush x:Key="DestaqueHover" Color="#1A86DD"/>
      <SolidColorBrush x:Key="Ok" Color="#4ADE80"/>
      <SolidColorBrush x:Key="Aviso" Color="#FBBF24"/>
      <SolidColorBrush x:Key="Erro" Color="#F87171"/>

      <FontFamily x:Key="Fonte">Segoe UI Variable Text, Segoe UI</FontFamily>
      <FontFamily x:Key="FonteTitulo">Segoe UI Variable Display, Segoe UI</FontFamily>
      <FontFamily x:Key="FonteMono">Cascadia Mono, Consolas</FontFamily>

      <!-- Ícones Lucide (viewBox 24, traço 1.5) -->
      <Geometry x:Key="IcCheck">M20 6 9 17l-5-5</Geometry>
      <Geometry x:Key="IcAlert">M21.73 18l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z M12 9v4 M12 17h.01</Geometry>
      <Geometry x:Key="IcX">M18 6 6 18 M6 6l12 12</Geometry>
      <Geometry x:Key="IcInfo">M12 2a10 10 0 1 0 0 20a10 10 0 1 0 0-20Z M12 16v-4 M12 8h.01</Geometry>
      <Geometry x:Key="IcScan">M3 7V5a2 2 0 0 1 2-2h2 M17 3h2a2 2 0 0 1 2 2v2 M21 17v2a2 2 0 0 1-2 2h-2 M7 21H5a2 2 0 0 1-2-2v-2 M7 12h10</Geometry>
      <Geometry x:Key="IcLayers">M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z M2 12l8.58 3.91a2 2 0 0 0 1.66 0L21 12 M2 17l8.58 3.91a2 2 0 0 0 1.66 0L21 17</Geometry>
      <Geometry x:Key="IcDisc">M12 2a10 10 0 1 0 0 20a10 10 0 1 0 0-20Z M12 10a2 2 0 1 0 0 4a2 2 0 1 0 0-4Z</Geometry>
      <Geometry x:Key="IcShield">M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1Z M9 12l2 2 4-4</Geometry>
      <Geometry x:Key="IcHardDrive">M22 12H2 M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11Z M6 16h.01 M10 16h.01</Geometry>
      <Geometry x:Key="IcRefresh">M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16 M8 16H3v5</Geometry>
      <Geometry x:Key="IcWrench">M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76Z</Geometry>

      <Style x:Key="Icone" TargetType="Path">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Stroke" Value="{StaticResource TextoFraco}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
      </Style>

      <!-- Botões -->
      <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="Background" Value="{StaticResource Superficie2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Linha}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource LinhaForte}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="B" Property="Opacity" Value="0.4"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="Primario" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Destaque}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Destaque}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource DestaqueHover}"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- Texto -->
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
      </Style>

      <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="Background" Value="{StaticResource Superficie}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Linha}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Texto}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Destaque}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Destaque}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="Log" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="FontFamily" Value="{StaticResource FonteMono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Foreground" Value="{StaticResource TextoFraco}"/>
        <Setter Property="Background" Value="#0E0E11"/>
      </Style>

      <!-- CheckBox -->
      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Caixa" Width="18" Height="18" CornerRadius="5" BorderThickness="1"
                        BorderBrush="{StaticResource LinhaForte}" Background="{StaticResource Superficie}" VerticalAlignment="Top" Margin="0,1,10,0">
                  <Path x:Name="Marca" Data="{StaticResource IcCheck}" Style="{StaticResource Icone}" Width="12" Height="12" Stroke="White" StrokeThickness="2.2" Visibility="Collapsed"/>
                </Border>
                <ContentPresenter Grid.Column="1" VerticalAlignment="Top"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Caixa" Property="Background" Value="{StaticResource Destaque}"/>
                  <Setter TargetName="Caixa" Property="BorderBrush" Value="{StaticResource Destaque}"/>
                  <Setter TargetName="Marca" Property="Visibility" Value="Visible"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Linha de opção (modos) -->
      <Style x:Key="Opcao" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="B" Background="{StaticResource Superficie}" BorderBrush="{StaticResource Linha}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="Anel" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" BorderBrush="{StaticResource LinhaForte}" VerticalAlignment="Top" Margin="0,2,14,0">
                    <Ellipse x:Name="Ponto" Width="8" Height="8" Fill="{StaticResource Destaque}" Visibility="Collapsed"/>
                  </Border>
                  <ContentPresenter Grid.Column="1"/>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource LinhaForte}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Destaque}"/>
                  <Setter TargetName="Anel" Property="BorderBrush" Value="{StaticResource Destaque}"/>
                  <Setter TargetName="Ponto" Property="Visibility" Value="Visible"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Foreground" Value="{StaticResource Destaque}"/>
        <Setter Property="Background" Value="{StaticResource Superficie2}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ProgressBar">
              <Grid x:Name="TemplateRoot">
                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"/>
                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
