<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\vinovim.ico</ApplicationIcon>
    <AssemblyName>VinovimWindowsFormat</AssemblyName>
    <RootNamespace>VinovimFormat</RootNamespace>
    <Version>1.1.0</Version>
    <Product>Vinovim Windows Format</Product>
    <Company>Vinovim</Company>
    <Copyright>© 2026 Vinovim</Copyright>
    <Description>Formata e reinstala o Windows 10/11 sem pen-drive.</Description>
    <SatelliteResourceLanguages>pt</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\vinovim.ico" />
  </ItemGroup>

</Project>
